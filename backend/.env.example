# Copy to .env.development or .env.production and fill in values.
# See backend/config/index.js for the full list.

# Partner form (/api/partners)
# Trusted reverse-proxy hops for req.ip (nginx / Vite dev proxy = 1)
TRUST_PROXY_HOPS=1
# Frontend build: VITE_TURNSTILE_SITE_KEY (Cloudflare Turnstile site key)
TURNSTILE_SECRET_KEY=
ADMIN_EMAIL=
# Comma-separated Mongo User _id values allowed to call GET /api/admin/stats
ADMIN_USER_IDS=
AZURE_COMM_CONNECTION_STRING=
AZURE_EMAIL_SENDER=
